# Скопируйте этот файл в .env и впишите свои данные
BOT_TOKEN=123456:ABC-ваш-токен-от-BotFather
# Ваш ID в Telegram (узнать: команда /myid в боте) — сюда приходят заявки
ADMIN_ID=
# Ссылка веб-приложения Apps Script (заканчивается на /exec)
WEB_APP_URL=
# Тот же секретный ключ, что в apps_script.gs
SECRET=
# Ссылка на саму таблицу (для команды /table)
SHEET_URL=
